{
  "name": "stepzone",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A web-based DDR/StepMania-compatible rhythm track player. Engine is framework-free TypeScript; UI is React.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/songselect.e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource/chakra-petch": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@webgpu/types": "^0.1.71",
    "playwright-core": "^1.61.1",
    "prettier": "^3.4.2",
    "puppeteer-core": "^25.3.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
