#!/bin/sh
# Fast local gates before anything leaves the machine: the checks that protect
# the Vercel prod deploy (which tracks master directly). The e2e browser suite
# is CI-only (.github/workflows/ci.yml) — at ~2-3 min per run it made every
# push take ~6 minutes locally, and CI re-runs it on the same commit anyway.
#
# Escape hatches (use sparingly): `git push --no-verify`, or SKIP_HOOKS=1.
[ -n "$SKIP_HOOKS" ] && { echo "pre-push: skipped (SKIP_HOOKS set)"; exit 0; }

fail() {
  echo ""
  echo "✗ push blocked — $1 failed. Fix it, or bypass with: git push --no-verify"
  exit 1
}

echo "▶ pre-push 1/3: prettier --check"
npm run --silent format:check || fail "formatting (npm run format)"

echo "▶ pre-push 2/3: tsc --noEmit"
npm run --silent typecheck || fail "typecheck"

echo "▶ pre-push 3/3: vitest run"
npm run --silent test || fail "unit tests"

echo "✓ pre-push passed — safe to push (e2e runs in CI)"
